# ---- LLM (Google Gemini) ----
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.7-flash

# ---- Image generation ----
# provider: huggingface | pollinations | gemini | placeholder
IMAGE_PROVIDER=huggingface
# Free HF token — must have the "Inference Providers" permission:
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_PROVIDER=auto
# Only used if IMAGE_PROVIDER=gemini (requires billing enabled on the key):
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ---- Scene media: "video" = Pexels stock footage (real motion), "image" = AI stills ----
MEDIA_MODE=video
# Free Pexels API key (no card): https://www.pexels.com/api/
PEXELS_API_KEY=

# ---- TTS (provider: edge = free/keyless w/ word timings, fish = premium) ----
TTS_PROVIDER=edge
TTS_VOICE=en-US-AriaNeural
# For Fish Audio (premium voice) — free key at https://fish.audio :
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free

# ---- Video ----
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
DEFAULT_SCENE_COUNT=6

# ---- App ----
OUTPUT_DIR=outputs
# Optional bearer token to protect the generate endpoint (blank = open)
API_TOKEN=

# Optional: point at a portable ffmpeg build (otherwise ffmpeg must be on PATH)
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
